# Copy this file to .env in the repo root, and to each agent folder
# that needs it, then fill in your own values.

GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# From the Meta developer console, WhatsApp Business Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# The Gmail address the Reporting Agent sends from
GMAIL_USER=
